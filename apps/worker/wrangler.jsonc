{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "access-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOW_LOCAL_AUTH": "false",
    "LOCAL_BOOTSTRAP_IDENTITY": "unset",
    "PROVIDER_WRITES_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS_BUCKET",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OUTBOX_QUEUE",
        "queue": "access-control-outbox",
      },
    ],
    "consumers": [
      {
        "queue": "access-control-outbox",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "access-control-dead-letter",
      },
    ],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "triggers": {
    "crons": ["0 */6 * * *"],
  },
  "env": {
    "staging": {
      "name": "access-control-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOW_LOCAL_AUTH": "false",
        "LOCAL_BOOTSTRAP_IDENTITY": "unset",
        "PROVIDER_WRITES_ENABLED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "access-control-staging",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "EXPORTS_BUCKET",
          "bucket_name": "access-control-staging-exports",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOX_QUEUE",
            "queue": "access-control-staging-outbox",
          },
        ],
        "consumers": [
          {
            "queue": "access-control-staging-outbox",
            "max_batch_size": 10,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "access-control-staging-dead-letter",
          },
        ],
      },
      "triggers": {
        "crons": ["0 */6 * * *"],
      },
    },
    "production": {
      "name": "access-control-prod",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOW_LOCAL_AUTH": "false",
        "LOCAL_BOOTSTRAP_IDENTITY": "unset",
        "PROVIDER_WRITES_ENABLED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "access-control-prod",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "EXPORTS_BUCKET",
          "bucket_name": "access-control-prod-exports",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOX_QUEUE",
            "queue": "access-control-prod-outbox",
          },
        ],
        "consumers": [
          {
            "queue": "access-control-prod-outbox",
            "max_batch_size": 10,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "access-control-prod-dead-letter",
          },
        ],
      },
      "triggers": {
        "crons": ["0 */6 * * *"],
      },
    },
  },
}
