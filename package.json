{
  "name": "access-control",
  "version": "0.1.0",
  "private": true,
  "description": "Access governance, application portal, declarative configuration, and provisioning control plane.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "wrangler dev --config apps/worker/wrangler.json --local --var ENVIRONMENT:development --var ALLOW_LOCAL_AUTH:true --var LOCAL_BOOTSTRAP_IDENTITY:access:local-admin",
    "deploy:dry-run": "pnpm run deployment -- dry-run --directory deployment/example",
    "types": "wrangler types --config apps/worker/wrangler.json",
    "lint": "eslint apps packages scripts test",
    "test": "vitest run",
    "smoke": "pnpm run db:migrate:local && vitest run test/integration/worker-runtime.test.ts",
    "check": "pnpm run config -- validate --file config/example.json && pnpm run deployment:validate-example && pnpm run deployment:schemas:check && pnpm run types && tsc --noEmit && pnpm run lint && prettier --check . && pnpm run test",
    "db:migrate:local": "wrangler d1 migrations apply DB --config apps/worker/wrangler.json --local",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "config": "tsx scripts/config.ts",
    "deployment": "tsx scripts/deployment.ts",
    "deployment:schemas": "tsx scripts/generate-deployment-schemas.ts",
    "deployment:schemas:check": "tsx scripts/generate-deployment-schemas.ts --check",
    "deployment:validate-example": "tsx scripts/deployment.ts validate --directory deployment/example"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "^1.5.1",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
